# Sentinel Verify Environment Configuration Example
FLASK_ENV=dev
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-key

# Database Connection (SQLite default, or PostgreSQL: postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///sentinel.db

# Optional CORS allowed origins
CORS_ORIGINS=*
